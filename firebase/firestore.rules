rules_version = '2';
// EVrywhere — Firestore güvenlik kuralları
// Dağıtım: firebase deploy --only firestore
//
// Koleksiyonlar (mevcut istemci kodu):
//   posts          — post_store / şarj akışı
//   forum_topics   — forum ekranı
//
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
    }

    // Yeni konular: authorId zorunlu ve giriş yapan kullanıcıyla aynı olmalı.
    // Eski dokümanlarda authorId yoksa güncelleme/silme kurallı geçmez (isteğe bağlı migrasyon).
    match /forum_topics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
    }

    // Gelecek: ikinci el ilanlar, yorum alt koleksiyonları, DM
    // match /listings/{listingId} { ... }
  }
}

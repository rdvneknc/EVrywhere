{
  "expo": {
    "name": "EVrywhere",
    "slug": "evrywhere",
    "owner": "evrywhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FBF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evrywhere.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F9ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.evrywhere.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Şarj istasyonlarını göstermek için konumunuz kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Forum ve ilan fotoğrafları eklemek için galeri erişimi gerekir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0adcd0b-2d09-4cd9-b4eb-7c936b068848"
      }
    }
  }
}
